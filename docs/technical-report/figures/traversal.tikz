% Key-block visiting order (Figure: traversal).
\begin{tikzpicture}[x=1cm,y=1cm,font=\sffamily\scriptsize,
  blk/.style={draw=mglight, fill=white, minimum width=0.74cm, minimum height=0.6cm, inner sep=0pt, line width=0.5pt},
  ord/.style={font=\sffamily\tiny, text=mgmuted, inner sep=1pt}]
  \node[anchor=east, align=right] at (-0.3,0) {\textbf{Original scan}\\ \code{mid\_window\_blocks=None}};
  \node[anchor=east, align=right] at (-0.3,-1.85) {\textbf{Mid-window (default)}\\ \code{mid\_window\_blocks=4}, diag $=3$};
  \foreach \i in {0,...,9} {
    \node[blk] (a\i) at (0.88*\i,0) {\i};
    \pgfmathtruncatemacro{\o}{10-\i}
    \node[ord, above=1pt of a\i] {\o};
    \node[blk] (b\i) at (0.88*\i,-1.85) {\i};
  }
  \node[blk, fill=cblue!16, draw=cblue, line width=0.9pt] at (b7) {7};
  \node[blk, draw=mgteal, line width=1.5pt] at (b3) {3};
  \node[blk, fill=cgraylt] at (b8) {8};
  \node[blk, fill=cgraylt] at (b9) {9};
  \foreach \i/\o in {7/1,6/2,5/3,4/4,3/5,2/6,1/7,0/8} { \node[ord, above=1pt of b\i] {\o}; }
  \node[ord, above=1pt of b8] {tail};
  \node[ord, above=1pt of b9] {tail};
  \draw[-{Latex[length=1.6mm]}, mgmuted, line width=0.6pt] ($(a9.south)+(0.1,-0.14)$) -- ($(a0.south)+(-0.1,-0.14)$);
  \draw[-{Latex[length=1.6mm]}, cblue, line width=0.7pt] ($(b7.south)+(0.1,-0.14)$) -- ($(b0.south)+(-0.1,-0.14)$);
  \draw[-{Latex[length=1.6mm]}, mgmuted, line width=0.6pt] ($(b0.south)+(0,-0.2)$) .. controls +(0.6,-0.75) and +(-0.6,-0.75) .. ($(b8.south)+(0,-0.2)$);
\end{tikzpicture}
